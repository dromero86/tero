# Configuración de la Aplicación
APP_NAME=Tero
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es

# Configuración de Base de Datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tero_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Configuración de Cache
CACHE_DRIVER=file
CACHE_PATH=storage/cache
CACHE_TTL=3600

# Configuración de Sesiones
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE_NAME=tero_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Configuración de Logging
LOG_ENABLED=true
LOG_PATH=storage/logs
LOG_LEVEL=INFO
LOG_CHANNEL=app

# Configuración de Templates
TEMPLATE_CACHE=true
TEMPLATE_PATH=themes/default
TEMPLATE_CACHE_DURATION=3600

# Configuración de Seguridad
SECURITY_CSRF=true
SECURITY_XSS=true
SECURITY_RATE_LIMIT=100
SECURITY_HEADERS=true
SECURITY_VALIDATION=true

# Configuración de Routing
ROUTING_ATTRIBUTES_ENABLED=true
ROUTING_MIDDLEWARE_CACHE=true
ROUTING_AUTO_DISCOVERY=true
AUTO_RUN=true
AUTO_LOAD_ROUTES=true
ROUTE_CACHE=true
ROUTE_CACHE_PATH=storage/cache/routes.php

# Configuración de Pipeline
PIPELINE_CACHE_ENABLED=true
PIPELINE_CACHE_PATH=storage/cache/pipeline
MIDDLEWARE_CACHE_ENABLED=true
ATTRIBUTE_CACHE_ENABLED=true
PIPELINE_DEBUG=false
PIPELINE_LOG_MIDDLEWARE=false

# Configuración de Autenticación
AUTH_JWT_SECRET=your-secret-key-here
AUTH_COOKIE_NAME=tero_token
AUTH_SESSION_LIFETIME=3600

# Configuración de Servidor Web
WEB_SERVER=apache
WEB_PROTOCOL=http1
WEB_HTTPS=false
APACHE_MOD_REWRITE=true
NGINX_FASTCGI=true
IIS_URL_REWRITE=true

# Configuración de Plataforma
PLATFORM=linux
CONTAINER=docker
WINDOWS_IIS=false
DOCKER_NETWORK=tero_network
DOCKER_VOLUME=tero_data

# Configuración de Cron Jobs
CRON_ENABLED=true
CRON_PATH=storage/cronjobs
CRON_AUTO_CLEANUP=true

# Configuración de Migraciones
MIGRATION_ENABLED=true
MIGRATION_PATH=storage/migrations
MIGRATION_AUTO_RUN=false

# Configuración de Output
OUTPUT_DEFAULT_FORMAT=json
OUTPUT_DEBUG_MODE=false

# Configuración de Internacionalización
I18N_ENABLED=true
I18N_DEFAULT_LOCALE=es
I18N_FALLBACK_LOCALE=en
I18N_SUPPORTED_LOCALES=es,en,fr

# Configuración de Storage
STORAGE_DEFAULT_DRIVER=local
STORAGE_LOCAL_PATH=storage/app
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=

# Configuración de Notificaciones
NOTIFICATION_MAIL_DRIVER=smtp
NOTIFICATION_MAIL_HOST=
NOTIFICATION_MAIL_PORT=587
NOTIFICATION_MAIL_USERNAME=
NOTIFICATION_MAIL_PASSWORD=
NOTIFICATION_MAIL_ENCRYPTION=tls
NOTIFICATION_MAIL_FROM_ADDRESS=noreply@tero.com
NOTIFICATION_MAIL_FROM_NAME="Tero Framework"

# Configuración de Queue
QUEUE_DEFAULT_DRIVER=database
QUEUE_DATABASE_TABLE=jobs
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_RETRY_AFTER=90
QUEUE_MAX_TRIES=3

# Configuración de Broadcasting
BROADCAST_DRIVER=log
BROADCAST_PUSHER_APP_ID=
BROADCAST_PUSHER_APP_KEY=
BROADCAST_PUSHER_APP_SECRET=
BROADCAST_PUSHER_APP_CLUSTER=mt1
BROADCAST_REDIS_CONNECTION=default
