{
    "name": "dromero86/tero",
    "description": "Tero is a powerfull framework",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "homepage": "https://github.com/dromero86/tero",
    "authors": [
        {
            "name": "Daniel Romero",
            "email": "dromero@ymail.com",
            "homepage": "https://github.com/dromero86/tero/",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": ">=8.1.0", 
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "vanilla/garden-cli": "^4.0",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Tero\\": "src/",
            "Tero\\Core\\": "src/Core/",
            "Tero\\Config\\": "src/Config/",
            "Tero\\Framework\\": "src/Framework/",
            "Tero\\Database\\": "src/Database/",
            "Tero\\Session\\": "src/Session/",
            "Tero\\Templates\\": "src/Templates/",
            "Tero\\Views\\": "src/Views/",
            "Tero\\Data\\": "src/Data/",
            "Tero\\Cache\\": "src/Cache/",
            "Tero\\Tools\\": "src/Tools/",
            "Tero\\Notifications\\": "src/Notifications/",
            "Tero\\Storage\\": "src/Storage/",
            "Tero\\I18n\\": "src/I18n/",
            "Tero\\Events\\": "src/Events/",
            "Tero\\Queue\\": "src/Queue/"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "Tero\\Tests\\": "tests/"
        }
    }
}